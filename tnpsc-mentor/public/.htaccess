# TNPSC Mentor — Apache config for Hostinger shared hosting (hPanel).
# Vite copies everything in /public to the build root, so this ships inside dist/.

# ── SPA fallback ──────────────────────────────────────────────────────────────
# The app is a single-page app: routes like /quiz, /result, /test-arena/pyq only
# exist client-side. Without this, refreshing or deep-linking those URLs returns
# Apache's 404. Rewrite every non-file request back to index.html so React Router
# can handle it.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Don't rewrite real files or directories (assets, favicon, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Everything else → index.html
  RewriteRule ^ index.html [L]
</IfModule>

# ── Caching ───────────────────────────────────────────────────────────────────
# Hashed asset filenames (index-XXXX.js) can be cached forever; index.html must
# always be revalidated so users get new builds immediately.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|svg|png|jpg|jpeg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Compression ───────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
