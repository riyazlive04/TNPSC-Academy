# Dependencies
node_modules
.pnp
.pnp.js

# Build output
dist
dist-ssr
*.local
*.zip

# Environment — never commit secrets (defense in depth; server has its own too)
.env
**/.env
.env.*
!.env.example
scrapers/.env

# Scraper output / working dirs
scrapers/*.json
scrapers/*.jsonl
scrapers/paraphrase_backup.jsonl
scrapers/_log_*.txt
scrapers/tnpsc_official_pdfs/
scrapers/tnpsc_official_ocr/

# Python
__pycache__/
*.py[cod]
.venv
venv/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Android signing keystore + signing credentials — NEVER commit
*.keystore
*.jks
keystore.properties
android/keystore.properties

# ─── Capacitor native projects ──────────────────────────────────────────────
# The android/ and ios/ PROJECTS are committed on purpose. They started as
# generated scaffolding, but they now carry hand-written configuration that
# `cap sync` does not and cannot regenerate — the iOS privacy manifest and
# entitlements, Info.plist keys, the ScreenSecure Swift/Java plugins, the App
# Links intent-filter, the backup rules, and the targetSdk 36 gradle pin.
# Regenerating from scratch silently produces a build that fails App Review.
#
# What stays ignored below is only genuine build output and machine-local paths.
*.apk
*.aab

# Copied web bundle — `cap sync` rewrites these from dist/ on every build.
android/app/src/main/assets/public/
ios/App/App/public/

# Android build output + machine-local SDK path
android/.gradle/
android/build/
android/app/build/
android/captures/
android/local.properties
android/app/release/
android/app/google-services.json

# iOS build output + dependency checkouts
ios/App/build/
ios/App/Pods/
ios/App/output/
ios/DerivedData/
ios/App/Podfile.lock
**/xcuserdata/
ios/App/App/capacitor.config.json
ios/App/App/config.xml
ios/capacitor-cordova-ios-plugins/

# Demo / marketing captures (generated by scripts/demo-record.mjs & make-commercial.mjs)
/recordings/
/demo.*
/commercial.*
/mobile.mp4
/phone.*

# Server scratch - image cache + ad-hoc data-script backups
server/_imgcache/
server/_*_backup.json
