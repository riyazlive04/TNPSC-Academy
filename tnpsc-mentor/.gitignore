# Dependencies
node_modules
.pnp
.pnp.js

# Build output
dist
dist-ssr
*.local
*.zip

# Environment — never commit secrets (defense in depth; server has its own too)
.env
**/.env
.env.*
!.env.example
scrapers/.env

# Scraper output / working dirs
scrapers/*.json
scrapers/*.jsonl
scrapers/paraphrase_backup.jsonl
scrapers/_log_*.txt
scrapers/tnpsc_official_pdfs/
scrapers/tnpsc_official_ocr/

# Python
__pycache__/
*.py[cod]
.venv
venv/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Android signing keystore — NEVER commit
*.keystore
*.jks

# Capacitor / native mobile build — generated project + build artifacts
/android/
/ios/
*.apk
*.aab
