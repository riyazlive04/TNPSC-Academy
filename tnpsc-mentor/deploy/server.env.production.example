# Server production env for the VPS. Copy to `server/.env` on the VPS and fill in.
# This file is read by the app's dotenv at boot. NEVER commit the filled-in copy.

# Same-origin deploy: API listens on localhost:4000, Nginx proxies /api to it.
PORT=4000

# Makes the refresh-token cookie Secure + SameSite=None (works over HTTPS).
NODE_ENV=production

# Allowed browser origin(s). Include the app subdomain (same-origin API calls)
# AND the main + www domains (the landing page's boot call to /api/auth/me is
# cross-origin from there). No trailing slash.
# IMPORTANT: the installed mobile app's WebView loads from https://localhost
# (Capacitor's default androidScheme) — and capacitor://localhost on iOS — so
# those MUST be allowed too, or every native API call (incl. Google login)
# fails with "Failed to fetch".
CORS_ORIGIN=https://app.tnpscmentors.in,https://tnpscmentors.in,https://www.tnpscmentors.in,https://localhost,capacitor://localhost

# ─── Supabase (unchanged from your current cloud project) ────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── Razorpay (copy from your current server/.env) ───────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Google sign-in ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=67295167549-tetha1nh7ltk2ivs5jj1ndp6eai3bvm4.apps.googleusercontent.com

# ─── Web Push (VAPID) — copy existing keys, or generate once with: ───────────
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@sirahdigital.in

# ─── MSG91 phone-OTP (leave blank until provisioned) ─────────────────────────
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_COUNTRY_CODE=91

# ─── AiSensy — WhatsApp signup OTP (see docs/WHATSAPP-OTP.md) ─────────────────
# Official WhatsApp Business API via AiSensy (API key + live API campaign name).
# When both are set, /register REQUIRES WhatsApp phone verification — also set
# VITE_SIGNUP_WA_OTP=true in the frontend build. Leave blank to disable.
AISENSY_API_KEY=
AISENSY_CAMPAIGN_NAME=signup_otp

# ─── Telegram bot — signup verification fallback (see docs/WHATSAPP-OTP.md) ──
# Full BotFather token ("<bot_id>:<secret>") + bot username (no @). After
# deploy, register the webhook once: node -r dotenv/config setup-telegram-webhook.mjs
# Blank = Telegram fallback disabled; also set VITE_SIGNUP_TG_VERIFY=true.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ─── Security alerts (see docs/BREACH_RESPONSE.md) ───────────────────────────
# Where breach/attack detections are delivered: failed-sign-in bursts, admin-route
# probing, 5xx spikes, privileged actions on user accounts. SET THIS — without a
# chat id the detections are written to the audit_log table and stderr but nobody
# is paged, and the Privacy Policy commits us to notifying the Data Protection
# Board "without undue delay". Get your numeric chat id by messaging @userinfobot.
# The token defaults to TELEGRAM_BOT_TOKEN above; override only for a separate bot.
SECURITY_ALERT_CHAT_ID=
SECURITY_ALERT_BOT_TOKEN=
