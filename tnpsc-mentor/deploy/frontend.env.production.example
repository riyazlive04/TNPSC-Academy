# Frontend production env for the VPS build (landing on main domain, app on
# subdomain). Copy to `.env.production` in the project root BEFORE `npm run build`.
# Vite inlines these at build time — rebuild after any change. ONE build is
# served on BOTH hostnames.

# The web app + API live on the app subdomain. Every API call targets this, so
# on the app subdomain it's same-origin (cookies work); on the main domain the
# landing page's one boot call to /api/auth/me is cross-origin → allowed by
# CORS_ORIGIN, returns 401, landing stays logged-out (correct).
# IMPORTANT: if empty, the build silently runs in UI-preview mode (no auth).
VITE_API_URL=https://app.tnpscmentors.in

# Public Google OAuth Web Client ID (safe to ship). Empty => Google button hidden.
# Must also be in the server's GOOGLE_CLIENT_ID and in Supabase → Auth → Google.
VITE_GOOGLE_CLIENT_ID=67295167549-tetha1nh7ltk2ivs5jj1ndp6eai3bvm4.apps.googleusercontent.com

# Show the Phone-OTP tab? Keep false until MSG91 is provisioned server-side.
VITE_OTP_LOGIN=false

# WhatsApp OTP at signup? MUST mirror the server's EVOLUTION_* state: true once
# the Evolution API gateway is live server-side, false before (send returns 503).
VITE_SIGNUP_WA_OTP=false

# Telegram fallback for numbers with no WhatsApp? Mirrors TELEGRAM_BOT_* on the
# server. Only meaningful alongside VITE_SIGNUP_WA_OTP=true.
VITE_SIGNUP_TG_VERIFY=false
