# ─── TNPSC Mentors API server ────────────────────────────────────────────────
# Port the Express API listens on. On the VPS, Nginx reverse-proxies /api to
# this localhost port (see deploy/README-VPS.md); keep it 4000 unless you also
# change the proxy_pass in deploy/nginx-tnpsc.conf.
PORT=4000

# Comma-separated list of allowed browser origins (the frontend).
# Local dev:   http://localhost:5173
# Production:  the app subdomain + main/www domains on the VPS, e.g.
#   https://app.tnpscmentors.in,https://tnpscmentors.in,https://www.tnpscmentors.in
#   (the installed mobile app's WebView also needs https://localhost +
#   capacitor://localhost). See deploy/server.env.production.example.
CORS_ORIGIN=http://localhost:5173

# ─── Supabase ────────────────────────────────────────────────────────────────
# Same project the SPA used to talk to directly. The server is now the ONLY
# client that holds these — the browser never sees the service-role key.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
# Service-role key — full DB access, SERVER ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── Razorpay (payments) ─────────────────────────────────────────────────────
# Dashboard → Settings → API Keys → Generate Test Key. KEY_ID (rzp_test_…) is
# public and is forwarded to the browser to open Checkout; KEY_SECRET is
# server-only — it signs orders and verifies payment signatures, never expose it.
# Leave both blank to run with payments disabled (the /api/payments routes then
# return 503). Switch rzp_test_… → rzp_live_… for production.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ─── Google sign-in (optional) ───────────────────────────────────────────────
# OAuth 2.0 Web Client ID from Google Cloud Console. NOT secret (it also ships to
# the browser as VITE_GOOGLE_CLIENT_ID). When unset, /api/auth/google returns 503
# and the frontend hides the Google button. The Client SECRET is NOT used here —
# it lives only in Supabase's Google provider settings. This same Client ID must
# ALSO be pasted into Supabase → Auth → Providers → Google → "Authorized Client
# IDs" for the ID-token sign-in to be accepted.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ─── Web Push (VAPID) — desktop/mobile push notifications (optional) ──────────
# Generate a key pair once with:  npx web-push generate-vapid-keys
# PUBLIC ships to the browser (served via /api/notifications/vapid-public-key);
# PRIVATE is server-only and signs push messages. SUBJECT is a mailto:/https:
# contact required by the spec. When the keys are blank, Web Push is disabled and
# the app uses in-app notifications only.
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com

# ─── MSG91 phone-OTP login (optional) ────────────────────────────────────────
# Enables "Sign in with phone" (alternate to email/password). MSG91 generates,
# SMSes and verifies the OTP against a DLT-registered template — no code is stored
# in our DB. AUTH_KEY is server-only (never shipped to the browser). When AUTH_KEY
# or TEMPLATE_ID is blank, the OTP endpoints return 503; also set the frontend's
# VITE_OTP_LOGIN=true to actually show the phone tab.
#   • AUTH_KEY:      MSG91 dashboard → Settings → API → Auth Key
#   • TEMPLATE_ID:   MSG91 → OTP → create an OTP template (linked to your approved
#                    DLT template) → copy its Template ID
#   • SENDER_ID:     your 6-char approved DLT header (optional; template's sender
#                    is used when blank)
#   • COUNTRY_CODE:  digits prefixed to the 10-digit mobile (default 91 = India)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_OTP_TEMPLATE_ID=your_msg91_otp_template_id
MSG91_SENDER_ID=
MSG91_COUNTRY_CODE=91

# ─── AiSensy — WhatsApp signup OTP (optional) ─────────────────────────────────
# Verifies ownership of the mobile number at signup: a one-time code is sent to
# the number's WhatsApp and /register requires the resulting verified-phone
# ticket. AiSensy (aisensy.com) rides the OFFICIAL WhatsApp Business API: build
# a Meta-approved template, wire it to an "API campaign", and this server
# triggers that campaign per send — setup guide: docs/WHATSAPP-OTP.md.
# When either value is blank, the /register/otp endpoints return 503 and
# /register behaves exactly as before (no phone verification). Also set the
# frontend's VITE_SIGNUP_WA_OTP=true so the signup form shows the code step.
#   • API_KEY:       AiSensy dashboard → Manage → API Key (a long JWT)
#   • CAMPAIGN_NAME: the live API campaign built on the approved AUTHENTICATION
#                    template (code as body param + copy-code button param)
AISENSY_API_KEY=your_aisensy_api_key
AISENSY_CAMPAIGN_NAME=signup_otp

# ─── Telegram bot — signup verification fallback (optional) ──────────────────
# For numbers with no WhatsApp: the signup page opens this bot via a one-time
# deep link and the user taps "Share my phone number"; the Telegram-verified
# contact must match the number being registered. Create the bot with
# @BotFather (/newbot), paste the FULL token ("<bot_id>:<secret>") and the
# bot's username (without @). Then register the webhook once:
#   node -r dotenv/config setup-telegram-webhook.mjs
# When either value is blank, /api/telegram returns 503 and signup offers
# WhatsApp only. Also set the frontend's VITE_SIGNUP_TG_VERIFY=true.
TELEGRAM_BOT_TOKEN=123456789:your_botfather_token
TELEGRAM_BOT_USERNAME=YourBotUsername_bot

# ─── Telegram channel — daily current-affairs PDFs (optional) ────────────────
# The superadmin console posts an approved CA issue to the public channel as an
# English PDF + a Tamil PDF (superadmin console → CA Magazine → Send). The bot
# above does the posting, so all that is normally needed is to add it to the
# channel as an ADMINISTRATOR with "Post Messages" permission.
# The channel is edited in the console (app_settings.telegram_ca_channel);
# this var is only the fallback for a fresh environment. Public channels use
# '@username', private ones the numeric chat id ('-1001234567890').
TELEGRAM_CA_CHANNEL=@tnpscmentors
# Optional: a SEPARATE publishing bot. Unset → TELEGRAM_BOT_TOKEN is used.
# TELEGRAM_CA_BOT_TOKEN=

# ─── Direct Postgres (migration/data scripts ONLY — not needed at runtime) ───
# Used by run-migration.mjs / load-subjects.mjs / backup-and-purge.mjs against
# the Supabase session pooler. The deployed API server does NOT require these.
# SUPABASE_DB_HOST=aws-1-ap-southeast-2.pooler.supabase.com
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_USER=postgres.YOUR-PROJECT-REF
# SUPABASE_DB_PASSWORD=your_db_password
# SUPABASE_DB_NAME=postgres

# ─── In-app purchases (App Store / Google Play) ──────────────────────────────
# The mobile apps must bill through the platform stores (Apple guideline 3.1.1,
# Google Play Payments policy); Razorpay stays the web-only rail. Receipts are
# verified server-side before any entitlement is written. See
# docs/MOBILE_RELEASE.md.

# App Store. No API key needed: StoreKit 2 receipts are JWS signed by Apple's own
# CA and verified offline against the root cert embedded in lib/iapApple.ts.
# APPLE_APP_APPLE_ID is the NUMERIC app id (App Store Connect → App Information
# → Apple ID); Apple requires it to verify Production transactions. Sandbox and
# TestFlight work without it, so leave it blank until the app record exists.
APPLE_BUNDLE_ID=com.tnpscmentor.app
APPLE_APP_APPLE_ID=

# Google Play. A Google Cloud service-account JSON key (verbatim or base64),
# invited into the Play Console with "View financial data, orders, and
# cancellation survey responses". Without it the Android IAP route returns 503
# and fails CLOSED — it never trusts an unverified purchase token.
GOOGLE_PLAY_PACKAGE_NAME=com.tnpscmentor.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# ─── Native push (FCM — covers BOTH Android and iOS) ─────────────────────────
# Web Push can't reach the installed apps (no Push API in WKWebView), so they
# register APNs/FCM device tokens instead. One Firebase project serves both:
# Android natively, iOS via the APNs auth key uploaded under Cloud Messaging.
# Falls back to GOOGLE_PLAY_SERVICE_ACCOUNT_JSON when it's the same project.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
