# ─── TNPSC Mentor API server ────────────────────────────────────────────────
# Port the Express API listens on. LOCAL ONLY — on Render, PORT is injected
# automatically; do NOT set it there (the server reads process.env.PORT).
PORT=4000

# Comma-separated list of allowed browser origins (the frontend).
# Local dev:   http://localhost:5173
# Production:  your Vercel URL, e.g. https://tnpsc-mentor.vercel.app
#              (add preview URLs too if you want PR previews to reach the API).
CORS_ORIGIN=http://localhost:5173

# ─── Supabase ────────────────────────────────────────────────────────────────
# Same project the SPA used to talk to directly. The server is now the ONLY
# client that holds these — the browser never sees the service-role key.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
# Service-role key — full DB access, SERVER ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── Direct Postgres (migration/data scripts ONLY — not needed at runtime) ───
# Used by run-migration.mjs / load-subjects.mjs / backup-and-purge.mjs against
# the Supabase session pooler. The deployed API server does NOT require these.
# SUPABASE_DB_HOST=aws-1-ap-southeast-2.pooler.supabase.com
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_USER=postgres.YOUR-PROJECT-REF
# SUPABASE_DB_PASSWORD=your_db_password
# SUPABASE_DB_NAME=postgres
