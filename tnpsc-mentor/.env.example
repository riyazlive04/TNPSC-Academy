# Base URL of the Express API server (see /server). The browser talks ONLY to
# this — Supabase keys now live exclusively on the server.
#
# Local dev:   http://localhost:4000
# Production:  the app subdomain on the VPS, e.g. https://app.tnpscmentors.in
#              (Nginx reverse-proxies /api there to the Express server). Vite
#              inlines this at BUILD time on the VPS — see deploy/README-VPS.md.
#              No trailing slash, no /api suffix. If this is unset in production
#              the app falls back to "UI-preview mode" (no auth) — so it MUST be set.
VITE_API_URL=http://localhost:4000

# ─── Google sign-in (optional) ───────────────────────────────────────────────
# OAuth 2.0 Web Client ID from Google Cloud Console — the SAME value as the
# server's GOOGLE_CLIENT_ID. It's public (it ships to the browser), so it's safe
# here. When unset, the "Continue with Google" button is hidden. Add your app
# domain (https://app.tnpscmentors.in) + http://localhost:5173 to the client's
# "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ─── Phone-OTP login (optional) ──────────────────────────────────────────────
# Set to "true" to show the "Phone OTP" sign-in tab. The server independently
# gates the OTP endpoints on its MSG91 credentials — keep this false until MSG91
# is configured server-side, otherwise the tab appears but every send returns 503.
VITE_OTP_LOGIN=false

# ─── WhatsApp signup OTP (optional) ──────────────────────────────────────────
# Set to "true" to verify the mobile number at signup with a WhatsApp code.
# MUST match the server's AiSensy state (AISENSY_* vars): with the server
# configured this MUST be true (registration demands the verified-phone
# ticket), and until then it MUST stay false (the send endpoint returns 503).
VITE_SIGNUP_WA_OTP=false

# ─── Telegram signup-verification fallback (optional) ────────────────────────
# Set to "true" to offer "Verify via Telegram" when the number has no WhatsApp.
# Mirrors the server's TELEGRAM_BOT_* config. Only meaningful alongside
# VITE_SIGNUP_WA_OTP=true.
VITE_SIGNUP_TG_VERIFY=false
